node_modules/
dist/
test/shots/
.DS_Store

# Secrets. The authoring tools read a key from here; it must never be committed.
.env
.env.*
!.env.example

# Style reference supplied by the user. Other people's work: kept locally for
# the authoring tools to feed to the image model, never committed.
docs/reference/

# Third-party agent skills, installed by tools/setup/install-skills.sh.
# Not vendored: img2threejs is 4.9 MB of someone else's Apache-2.0 repo and a
# committed copy would silently fork it.
.claude/skills/

__pycache__/
*.pyc

# Working state for a tools/setup/install-skills.sh skill run. Scratch, not art.
tools/img2threejs-work/

# scratch probes written next to the real harnesses
test/.*.mjs

# stray output from running test/portraits.mjs with a URL in the path argument
http:/

# raw Nano Banana generations — cached so a repack is free, but they are
# regenerable and large; the packed atlas-nano.png is what the renderer reads
tools/voxel-fridge/.cache/
tools/voxel-fridge/views/
