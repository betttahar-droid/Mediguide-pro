{
  "name": "pharmacy-builder",
  "version": "0.1.0",
  "description": "Pharmacy modular builder — modular, resizable pharmacy furniture in a pixel-art low-poly style",
  "scripts": {
    "dev": "vite",
    "viewer:semantic-freezer": "vite --host 127.0.0.1 --port 5186 --strictPort --open /tools/semantic-freezer-viewer/index.html",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node test/smoke.mjs",
    "test:fridge-source": "node test/source-true-fridge.mjs",
    "build:fridge-source": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/authoring/build_fridge_source_true.ps1",
    "gate:fridge-source": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/authoring/gate_fridge_source.ps1",
    "measure:fridge-grid": "node test/measure-fridge-grid.mjs",
    "test:fridge-adaptive": "node test/fridge-adaptive-atlas.mjs && node test/adaptive-assembly.mjs",
    "test:fridge-analytic": "node test/fridge-analytic-material.mjs",
    "test:fridge-strict-sdf": "node test/strict-sdf-fridge.mjs",
    "test:fridge-nano-decals": "node test/fridge-nano-decals-v6.mjs",
    "test:fridge-style-fit-v7": "node test/fridge-style-fit-v7.mjs",
    "test:fridge-ps1-decals-v8": "node test/fridge-ps1-decals-v8.mjs",
    "test:voxel-fridge-recipe": "node test/voxel-fridge-recipe-v9.mjs",
    "test:voxel-fridge-adaptive-decals": "node test/voxel-fridge-adaptive-decals-v10.mjs",
    "test:voxel-fridge-paintover-atlas": "node test/voxel-fridge-paintover-atlas-v11.mjs",
    "test:voxel-fridge-handbook": "node test/voxel-fridge-handbook-v12.mjs",
    "test:voxel-fridge-semantic": "node test/voxel-fridge-semantic-v13.mjs",
    "test:semantic-freezer": "node test/semantic-freezer-v1.mjs",
    "test:semantic-freezer-v2": "node test/semantic-freezer-v2.mjs",
    "test:semantic-freezer-v3": "node test/semantic-freezer-v3.mjs",
    "prepare:semantic-freezer-v4": "python tools/authoring/prepare_semantic_freezer_v4.py",
    "generate:semantic-freezer-v4": "python tools/authoring/generate_semantic_freezer_v4_paintovers.py",
    "compile:semantic-freezer-v4": "python tools/authoring/compile_semantic_freezer_v4.py",
    "test:semantic-freezer-v4": "node test/semantic-freezer-v4.mjs",
    "prepare:semantic-freezer-v5": "python tools/authoring/prepare_semantic_freezer_v5.py",
    "generate:semantic-freezer-v5": "python tools/authoring/generate_semantic_freezer_v5_features.py",
    "compile:semantic-freezer-v5": "python tools/authoring/compile_semantic_freezer_v5.py",
    "test:semantic-freezer-v5": "node test/semantic-freezer-v5.mjs",
    "compile:semantic-freezer-v6": "python tools/authoring/compile_semantic_freezer_v6.py",
    "audit:semantic-freezer-v6": "python tools/authoring/audit_semantic_freezer_v6.py",
    "test:semantic-freezer-v6": "node test/semantic-freezer-v6.mjs",
    "compile:semantic-freezer-v7": "python tools/authoring/compile_semantic_freezer_v7.py",
    "audit:semantic-freezer-v7": "python tools/authoring/audit_semantic_freezer_v7.py",
    "test:semantic-freezer-v7": "node test/semantic-freezer-v7.mjs",
    "prop-factory:example": "python tools/authoring/compile_semantic_freezer_v7.py && python tools/prop-factory/prop_factory.py build --spec tools/prop-factory/examples/semantic-freezer/asset-spec.json --out docs/reference-lock/semantic-freezer-v7/prop-factory",
    "test:prop-factory": "python test/prop-factory.py",
    "prop-factory:studio": "node tools/prop-factory/studio/server.mjs",
    "test:prop-factory-studio": "node test/prop-factory-studio.mjs",
    "test:semantic-freezer-viewer": "node test/semantic-freezer-viewer.mjs",
    "build:fridge-gpt-materials": "node tools/authoring/build_gpt_fridge_materials.mjs",
    "build:fridge-nano-materials": "python tools/authoring/measure_fridge_texture_style.py && python tools/authoring/build_nano_fridge_materials_v5.py",
    "build:fridge-variants": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/authoring/build_fridge_variants.ps1",
    "gate:fridge-variants": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/authoring/gate_fridge_variants.ps1",
    "portraits": "node test/portraits.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/betttahar-droid/Mediguide-pro.git"
  },
  "bugs": {
    "url": "https://github.com/betttahar-droid/Mediguide-pro/issues"
  },
  "homepage": "https://github.com/betttahar-droid/Mediguide-pro#readme",
  "dependencies": {
    "lil-gui": "^0.21.0",
    "stats.js": "^0.17.0",
    "three": "^0.185.1",
    "vite": "^8.2.2"
  },
  "private": true,
  "type": "module",
  "devDependencies": {
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0"
  }
}
